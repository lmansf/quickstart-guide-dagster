# Copy to .env to turn on publishing:  cp .env.example .env
#
# Dagster's CLI (dagster dev, dagster job execute) loads .env from the project
# root automatically, so the UI, the daemon, and its schedules all see these.
# .env is gitignored — it is your machine's config, not the repo's.

# Commit and push the refreshed report so the static host redeploys it.
# Unset (or anything other than 1/true/yes/on) = export only, never touch git.
PUBLISH_REPORT=1

# Branch your host deploys from. Defaults to the branch you have checked out.
PUBLISH_BRANCH=main

# Git remote to push to. Defaults to origin.
PUBLISH_REMOTE=origin
